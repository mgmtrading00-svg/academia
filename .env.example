# Sin estas dos variables la app arranca en modo demostración (tienda de ejemplo, datos en memoria).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para los agentes en el servidor. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Empleados: una sola clave de Gemini (Google) para todas las tiendas. Sin ella, su trabajo se simula.
GEMINI_API_KEY=
# Foto en modelo: Google la cobra (no tiene nivel gratuito). Pon «si» para activarla.
# Sin activarla, Teo endereza, aclara y encuadra la foto él mismo, gratis.
GEMINI_FOTOS_MODELO=no
# Opcional: cambiar de modelo sin tocar código.
# GEMINI_VISION_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
